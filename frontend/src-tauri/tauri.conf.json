{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Model Router",
  "version": "0.2.1",
  "identifier": "com.localmodelrouter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5175 --strictPort",
    "devUrl": "http://127.0.0.1:5175",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local Model Router",
        "width": 1088,
        "height": 713,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyRkEyNTU5NDc2N0MxNDcKUldSSHdXZEhXU1g2QWdxZEg4b3l5QTB0alJFQ3NnVnFBSFVRYWE2Wk5OQ0xLK01DR3pjZjNYbjcK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Personal local model routing service",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh",
        "compression": "zlib"
      }
    }
  }
}
